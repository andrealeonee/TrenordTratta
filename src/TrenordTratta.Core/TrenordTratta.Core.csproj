<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Logica indipendente dalla UI: client API, merge dei dati, persistenza.
    Target net8.0 così è testabile ovunque; l'app MAUI (net10.0-android) la referenzia senza problemi.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>TrenordTratta.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="8.10.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" />
    <PackageReference Include="sqlite-net-pcl" Version="1.9.172" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TrenordTratta.Core.Tests" />
  </ItemGroup>

</Project>
