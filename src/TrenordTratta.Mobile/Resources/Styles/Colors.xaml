<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Color x:Key="Primary">#0B5D3B</Color>
    <Color x:Key="PrimaryDark">#06402A</Color>
    <Color x:Key="OnPrimary">#FFFFFF</Color>
    <Color x:Key="OnPrimaryMuted">#CCFFFFFF</Color>

    <Color x:Key="PageLight">#F5F6F4</Color>
    <Color x:Key="PageDark">#121412</Color>
    <Color x:Key="CardLight">#FFFFFF</Color>
    <Color x:Key="CardDark">#1E211E</Color>
    <Color x:Key="TextLight">#1B1C1B</Color>
    <Color x:Key="TextDark">#ECEDEC</Color>
    <Color x:Key="MutedLight">#6B706B</Color>
    <Color x:Key="MutedDark">#9BA19B</Color>
    <Color x:Key="DividerLight">#E3E5E2</Color>
    <Color x:Key="DividerDark">#2C302C</Color>

    <Color x:Key="WarningBg">#FFF4D6</Color>
    <Color x:Key="WarningText">#6B4E00</Color>
    <Color x:Key="ErrorBg">#FDE2E0</Color>
    <Color x:Key="ErrorText">#8C1D18</Color>

</ResourceDictionary>
