<?xml version="1.0" encoding="utf-8" ?>
<views:AutoRefreshPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                       xmlns:views="clr-namespace:TrenordTratta.Mobile.Views"
                       xmlns:vm="clr-namespace:TrenordTratta.Mobile.ViewModels"
                       x:Class="TrenordTratta.Mobile.Views.TrainDetailPage"
                       x:DataType="vm:TrainDetailViewModel"
                       Title="{Binding Title}">

    <RefreshView IsRefreshing="{Binding IsRefreshing}" Command="{Binding RefreshCommand}"
                 RefreshColor="{StaticResource Primary}">
        <CollectionView ItemsSource="{Binding Stops}" SelectionMode="None">

            <CollectionView.Header>
                <VerticalStackLayout Spacing="0" Padding="0,8,0,0">

                    <Label Text="{Binding ErrorMessage}" Padding="16,10" Margin="0,0,0,4"
                           BackgroundColor="{StaticResource ErrorBg}" TextColor="{StaticResource ErrorText}">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding ErrorMessage}" Value="">
                                <Setter Property="IsVisible" Value="False" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>

                    <!-- Riepilogo sulla mia tratta -->
                    <Border Style="{StaticResource Card}">
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="6">
                            <Label Text="{Binding RouteText}" FontAttributes="Bold" FontSize="16" Grid.ColumnSpan="2" />

                            <Label Grid.Row="1" Style="{StaticResource Muted}">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="Partenza  " />
                                        <Span Text="{Binding DepartureText}" FontAttributes="Bold" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                            <Label Grid.Row="1" Grid.Column="1" Text="{Binding DelayText}" TextColor="{Binding DelayColor}"
                                   FontAttributes="Bold" HorizontalTextAlignment="End" />

                            <Label Grid.Row="2" Style="{StaticResource Muted}">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="Arrivo  " />
                                        <Span Text="{Binding ArrivalText}" FontAttributes="Bold" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                            <Label Grid.Row="2" Grid.Column="1" Text="{Binding PlatformText}" HorizontalTextAlignment="End" />

                            <Label Grid.Row="3" Grid.ColumnSpan="2" Text="{Binding LastUpdate}" Style="{StaticResource Muted}" FontSize="11" />
                        </Grid>
                    </Border>

                    <!-- Affollamento (solo se attivo nelle impostazioni) -->
                    <Border Style="{StaticResource Card}" IsVisible="{Binding ShowCrowding}">
                        <VerticalStackLayout Spacing="6">
                            <HorizontalStackLayout Spacing="8">
                                <BoxView Color="{Binding CrowdingColor}" WidthRequest="12" HeightRequest="12" CornerRadius="6" VerticalOptions="Center" />
                                <Label Text="{Binding CrowdingText}" FontAttributes="Bold" />
                            </HorizontalStackLayout>
                            <ProgressBar Progress="{Binding CrowdingProgress}" ProgressColor="{Binding CrowdingColor}" />
                            <Label Text="{Binding CrowdingSourceText}" Style="{StaticResource Muted}" FontSize="11" />
                        </VerticalStackLayout>
                    </Border>

                    <Button Text="{Binding TakenButtonText}" Command="{Binding ToggleTakenCommand}" Margin="12,8" />

                    <Label Text="FERMATE" Style="{StaticResource SectionTitle}" />
                </VerticalStackLayout>
            </CollectionView.Header>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:StopItemViewModel">
                    <Grid Padding="16,8" ColumnDefinitions="16,*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="10">
                        <BoxView Grid.RowSpan="2" Color="{Binding DotColor}" WidthRequest="10" HeightRequest="10"
                                 CornerRadius="5" VerticalOptions="Center" HorizontalOptions="Center" />

                        <Label Grid.Column="1" Text="{Binding Name}" FontAttributes="{Binding NameAttributes}"
                               Opacity="{Binding NameOpacity}" LineBreakMode="TailTruncation">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding IsCancelled}" Value="True">
                                    <Setter Property="TextDecorations" Value="Strikethrough" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                        <Label Grid.Column="1" Grid.Row="1" Text="{Binding PlatformText}" Style="{StaticResource Muted}" FontSize="12" />

                        <VerticalStackLayout Grid.Column="2" Grid.RowSpan="2" HorizontalOptions="End">
                            <Label HorizontalTextAlignment="End">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="{Binding ScheduledText}" FontAttributes="Bold" />
                                        <Span Text="  " />
                                        <Span Text="{Binding ActualText}" TextColor="{Binding StatusColor}" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                            <Label Text="{Binding StatusText}" TextColor="{Binding StatusColor}" FontSize="12"
                                   HorizontalTextAlignment="End" />
                        </VerticalStackLayout>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <CollectionView.Footer>
                <Label Text="Orari reali da Trenord; dove mancano, da ViaggiaTreno."
                       Style="{StaticResource Muted}" FontSize="11" HorizontalTextAlignment="Center" Margin="16,12,16,24" />
            </CollectionView.Footer>
        </CollectionView>
    </RefreshView>
</views:AutoRefreshPage>
